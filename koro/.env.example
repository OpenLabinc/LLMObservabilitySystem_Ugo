# Leave these unset to run seed mode with no cloud credentials.
# `npm run dev` starts a local SurrealDB 3 memory process on 127.0.0.1
# and the app connects with the JS SDK. No token is bundled.
#
# For SurrealDB Cloud later, set the URL at deploy time as a Worker secret
# named SURREAL_URL (server only). Do not put it in a VITE_ variable.
# VITE_SURREAL_URL=
# VITE_SURREAL_NS=koro
# VITE_SURREAL_DB=network
