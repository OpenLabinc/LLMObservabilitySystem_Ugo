PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173

# Google Calendar for the Gmail account you connect.
# Enable Google Calendar API, then create an OAuth desktop/web client.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/connect/google/callback

# Optional passphrase used to encrypt Apple app passwords and Google refresh tokens at rest.
TOKEN_KEY=

# SurrealDB 3.x. The server starts a local instance when this URL is closed.
SURREAL_URL=ws://127.0.0.1:8000
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=calendar
SURREAL_DB=main
SURREAL_BIN=surreal
